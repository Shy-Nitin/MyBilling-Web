# ==============================================================================
# MyBilling - Environment Configuration Example
# ==============================================================================

# 1. Database Connection (PostgreSQL / Supabase)
# Local SQLite fallback: sqlite:///./mybilling.db
# Production Supabase Pooler (Port 6543, Transaction mode for Serverless):
DATABASE_URL=postgresql+psycopg2://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?sslmode=require

# 2. Supabase API & Auth Configuration
# Obtain from: Supabase Dashboard -> Project Settings -> API & Auth
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Supabase JWT Secret (Project Settings -> API -> JWT Secret)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# 3. Application Security & JWT
JWT_SECRET_KEY=generate-a-strong-random-32-char-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# 4. Environment Flags
ENVIRONMENT=production
COOKIE_SECURE=True
COOKIE_SAMESITE=lax

# 5. Frontend (Vite) Supabase Keys (Optional client-side Supabase SDK integration)
VITE_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


postgresql://postgres.tsodwkrhziviphfpgyhh:[]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres